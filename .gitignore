!/package-lock.json

# VS Code
.vscode/
.breakpoints

# Replit
.replit
replit.nix
.replit_setup_done
nvm/
.claude/
.cursor/

# MIRA (Claude Code conversation memory)
.mira/

# Inter-instance coordination mailbox — local-only (see /Users/mrathbone/github/Nebuspace/CLAUDE.md)
CROSS-CLAUDE.md
CROSS-CLAUDE.archive.md

# Local-only private context (holds developer identity) — never commit
CLAUDE.local.md

# Playwright
playwright-report/
playwright-reports/
playwright-screenshots/
test-results/
*/playwright-report/
**/playwright-report/
*/test-results/
**/test-results/
e2e_tests/test-results.json
e2e_tests/screenshots/

# Prevent accidental screenshots in root directory
/*.png
/*.jpg
/*.jpeg
/test-*.png
/screenshot-*.png
/debug-*.png

# Logs
*.log
logs/

# Local dev scripts (contain personal info / VM credentials)
dev-scripts/

# Project specific
generated-icon.png


# macOS
.DS_Store

# Vite build artifacts (must not be committed — regenerated by CI/local builds)
services/admin-ui/dist/
services/player-client/dist/

# Vitest coverage output (WO-TESTCOV-PLAYER-CLIENT — regenerable via npm run test:coverage)
services/player-client/coverage/

# Proof / scratch artifacts from build-and-prove runs (WO-SW-PRIMARY-TREE-HYGIENE).
# Kept on disk deliberately — these are evidence from past WOs, not garbage — but
# ignored so "primary tree dirty" is a checkable defect again for multi-seat work.
.neon-proof/
services/player-client/.neon-proof/
services/player-client/.tmp-overlay-screenshots/

# Per-seat working state: symlink to the seat's currently-active plan. Local to each
# instance (the PostCompact hook reads it to re-anchor), so committing it would thrash
# between concurrent seats.
.samantha/plan.md
